{
  "extends": "./tsconfig",
  "include": ["src/main/webapp/app", "src/main/webapp/microfrontend"],
  "exclude": [],
  "compilerOptions": {
    "paths": {
      "app/*": ["src/main/webapp/app/*"],
      "@/src/main/webapp/app/*": ["src/main/webapp/app/*"],
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./src/main/webapp/app/lib/*"]
    },
    "types": ["jest", "webpack-env"]
  }
}
